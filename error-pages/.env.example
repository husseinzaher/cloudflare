# One business, one file. Copy this to `.env`, fill it in, and every generated
# page, the worker's routes and the deployed worker's name follow from it:
#
#   cp .env.example .env && npm run deploy
#
# Every key here can also be set as a Cloudflare build variable (Workers Builds
# settings -> Variables and secrets); those win over this file, and the build log
# names the ones that did. Prefer the file - it is reviewable in a diff.
#
# COMMIT THE .env FILE. It holds branding, not secrets - no keys, no tokens -
# and Cloudflare's builder only sees what is in the repository. A gitignored
# .env means the build falls back to sites.config.json and deploys the wrong
# brand. (For many businesses in one deployment, ignore this file entirely and
# list them in sites.config.json instead; see README.)

# --- Where it runs -----------------------------------------------------------
# The domain to protect. ZONE is the Cloudflare zone it belongs to - the same
# value unless the site is a subdomain of a larger zone.
DOMAIN=example.com
ZONE=example.com
# Extra hostnames sharing this branding, comma separated. Subdomains inherit
# from their parent automatically, so this is only for genuinely other names.
EXTRA_DOMAINS=www.example.com

# The Cloudflare Worker's name. Must match the project name in the dashboard.
WORKER_NAME=edge-error-pages

# --- Who it is ---------------------------------------------------------------
BRAND_NAME=Example
# The name as it reads in an English sentence, if that differs.
BRAND_NAME_EN=
# The mark in the page footer. Defaults to BRAND_NAME.
BRAND_WORDMARK=

# The language the page leads in. RTL is detected from it - layout, mirroring
# and animation direction follow. Shipped: ar, en, fr (add more in ui.json).
LOCALE=en
# A second language echoed underneath, or empty for none.
SECONDARY_LOCALE=

# --- How it looks ------------------------------------------------------------
# Only these are needed; the rest of the palette is derived from them.
COLOR_BG_FROM=#0b1020
COLOR_BG_TO=#111a3a
COLOR_PRIMARY=#4f46e5
COLOR_ACCENT=#06b6d4

# Optional refinements. Left empty, each falls back to COLOR_PRIMARY.
COLOR_PRIMARY_STRONG=
COLOR_PRIMARY_SOFT=
COLOR_PRIMARY_TINT=

# The three error tones: amber for "your request was wrong", red for "we broke".
COLOR_WARNING=#ebaa2d
COLOR_DESTRUCTIVE=#dc5b4d
COLOR_FOREGROUND=#ffffff
COLOR_MUTED_FOREGROUND=#a8abc4

# Typography. FONT_GOOGLE is the page's only external request - leave it empty
# to depend on nothing at all.
FONT_STACK="Inter", "Segoe UI", system-ui, sans-serif
FONT_LATIN_STACK=
FONT_GOOGLE=

# --- How it behaves ----------------------------------------------------------
# What the "wait it out" pages poll to know the site is back.
HEALTH_PATH=/

# Routes whose callers parse JSON and must never receive a web page.
JSON_PREFIXES=/api/

# Also write the generated page where the site's own web server serves it,
# relative to this directory. Empty means the edge worker is the only consumer.
STATIC_OUT_DIR=
