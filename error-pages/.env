# One business, one file - see .env.example for every key and what it does.
#
# Committed on purpose: none of this is a secret, and Cloudflare's builder only
# ever sees what is in the repository. The GitHub token is the one value here
# that is a secret, and it lives as a Worker secret instead:
#   npx wrangler secret put GITHUB_TOKEN
#
# Only keys that differ from the "tajeerai" entry in sites.config.json belong
# here; everything else is inherited from it.

# --- Knowing it went down ---
# The repository the uptime watch files issues against. Naming it is what turns
# the watch on and adds the cron trigger to wrangler.toml.
MONITOR_REPO=husseinzaher/tajeerai
MONITOR_CRON=*/5 * * * *
